# Noctalia shell — reference settings
#
# This is a sanitized snapshot of ~/.local/state/noctalia/settings.toml
# (the file Noctalia actually writes when you change settings in its GUI).
#
# install.sh copies this to $XDG_STATE_HOME/noctalia/settings.toml ONLY if
# that file does not already exist (it never overwrites live runtime state)
# and substitutes the @HOME@ placeholder with your real home directory.
#
# You can also just change things from Noctalia's own settings GUI.

config_version = 14

[bar.default]
capsule = true
center = []
end = [
    "media",
    "tray",
    "clipboard",
    "network",
    "bluetooth",
    "volume",
    "widget",
    "brightness",
    "battery",
    "control-center",
    "session"
]
margin_ends = 450
start = [ "notifications", "clock" ]

[idle]
behavior_order = [ "lock", "screen-off", "lock-and-suspend" ]

    [idle.behavior.lock]
    action = "lock"
    enabled = true
    timeout = 300.0

    [idle.behavior.lock-and-suspend]
    action = "lock_and_suspend"
    enabled = false
    timeout = 900.0

    [idle.behavior.screen-off]
    action = "screen_off"
    enabled = true
    timeout = 660.0

[lockscreen]
wallpaper = "@HOME@/Pictures/dotfiles-wallpapers/pexels-maxfrancis-2246476.jpg"

[lockscreen_widgets]
enabled = true
schema_version = 2
# NOTE: widget coordinates below were authored on a 1366x768 "eDP-1" output.
# Adjust the `output` keys / positions to match your own display(s).
widget_order = [ "lockscreen-login-box@eDP-1", "lockscreen-widget-0000000000000001" ]

    [lockscreen_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [lockscreen_widgets.widget."lockscreen-login-box@eDP-1"]
    box_height = 196.0
    box_width = 810.0
    cx = 683.0
    cy = 569.5
    output = "eDP-1"
    placement_height = 768.0
    placement_width = 1366.0
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@eDP-1".settings]
        background_color = "surface_variant"
        background_opacity = 0.88
        background_radius = 12.0
        center_password_text = false
        input_opacity = 1.0
        input_radius = 6.0
        layout = "regular"
        show_caps_lock = true
        show_keyboard_layout = true
        show_login_button = true
        show_media = true
        show_session_buttons = true
        show_unlock_hint = true
        show_weather = true

    [lockscreen_widgets.widget.lockscreen-widget-0000000000000001]
    box_height = 176.0
    box_width = 256.0
    cx = 675.0
    cy = 264.0
    output = "eDP-1"
    placement_height = 768.0
    placement_width = 1366.0
    rotation = 0.0
    type = "clock"

[nightlight]
enabled = true

[plugin_settings."noctalia/screen_recorder"]
video_encoder = "cpu"
video_source = "focused"

[plugins]
# community plugins must be installed from Noctalia's plugin browser
enabled = [ "noctalia/screen_recorder", "blackbartblues/audio-switcher" ]

[shell]
screen_time_enabled = true

[theme]
builtin = "Tokyo-Night"
community_palette = "Oxocarbon"
mode = "dark"
source = "builtin"
wallpaper_scheme = "m3-content"

    [theme.templates]
    builtin_ids = [ "btop", "gtk3", "gtk4", "kitty", "niri", "qt" ]

[wallpaper]
directory = "@HOME@/Pictures/dotfiles-wallpapers"

    [wallpaper.default]
    path = "@HOME@/Pictures/dotfiles-wallpapers/kitty-wall.jpg"

    [wallpaper.last]
    path = "@HOME@/Pictures/dotfiles-wallpapers/kitty-wall.jpg"

    [wallpaper.monitors.eDP-1]
    path = "@HOME@/Pictures/dotfiles-wallpapers/kitty-wall.jpg"

[widget.brightness]
show_label = false

[widget.launcher]
enabled = false

[widget.media]
enabled = false

[widget.network]
show_label = false

[widget.volume]
enabled = false
show_label = false

[widget.wallpaper]
enabled = false

[widget.widget]
type = "blackbartblues/audio-switcher:widget"

[widget.workspaces]
enabled = false